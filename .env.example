# Salin ke .env.local lalu isi. Hanya dibaca di server (jangan pakai NEXT_PUBLIC_).
JIRA_BASE_URL=https://namasite.atlassian.net
JIRA_EMAIL=nama@perusahaan.co.id
JIRA_API_TOKEN=isi_api_token_di_sini
JIRA_JQL=filter = 12345 AND (statusCategory != Done OR created >= startOfDay()) ORDER BY updated DESC
